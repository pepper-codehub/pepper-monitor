[Unit]
Description=SSH tunnel to RainYun server (remote 8082/8083 to local 8888/8889)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/pepper-monitor/tunnel.env
ExecStart=/usr/bin/ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -R 8082:127.0.0.1:8888 -R 8083:127.0.0.1:8889 -i ${SSH_KEY} -p ${SSH_PORT} -N ${SSH_USER}@${SSH_HOST}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
