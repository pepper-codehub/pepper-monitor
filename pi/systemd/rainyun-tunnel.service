[Unit]
Description=SSH tunnel to RainYun server (ports 8888 + 8889)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -R 8082:localhost:8888 -R 8083:localhost:8889 -i /home/ckjoy/.ssh/id_ed25519 -p 34941 -N root@103.45.162.207
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
