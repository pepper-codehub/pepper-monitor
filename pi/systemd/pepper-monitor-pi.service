[Unit]
Description=Pepper Audio Monitor Server on Pi (Port 8889)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/pepper-monitor
ExecStart=%h/.local/share/pepper-monitor/venv/bin/python -u %h/.local/share/pepper-monitor/pi/scripts/monitor_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
