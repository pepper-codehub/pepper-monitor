[Unit]
Description=Pepper Camera HTTP Server on Pi (Port 8888)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/pepper-monitor
ExecStart=%h/.local/share/pepper-monitor/venv/bin/python -u %h/.local/share/pepper-monitor/pi/scripts/camera_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
