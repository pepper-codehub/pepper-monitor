[Unit]
Description=Pepper Monitor HTTPS Web Service (Port 8443)
After=network-online.target ws-audio-proxy.service
Wants=network-online.target ws-audio-proxy.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/webcam-dashboard
ExecStart=/usr/bin/python3 -u /opt/webcam-dashboard/server_async_simple_fix.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
